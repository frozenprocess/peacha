# OAuth credentials for `make dev-auth`. Copy to .env.auth (gitignored) and fill
# in the provider(s) you want to test - any provider with a client id + secret
# is enabled; the rest stay off. Values are sourced into the environment, where
# the editor's --slack-*/--google-*/--github-* flags pick them up via their env
# fallbacks (see cmd/editor/main.go).

EXAMS_DISABLED=false

# Pin the callback origin so OAuth redirect URIs are deterministic and resolve
# back through the vite proxy (vite serves the SPA on :5173 and proxies /v1 to
# the Go server on :8080). Register this provider redirect URI in the app:
#   http://localhost:5173/v1/auth/callback/<provider>
AUTH_BASE_URL=http://localhost:5173

# Sign session cookies with a fixed key so logins survive a server restart
# during development (omit to mint a random key each run).
SESSION_SECRET=dev-only-change-me

# --- GitHub (easiest for local dev - allows an http://localhost redirect) ----
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_ORG=your-org   # optional: restrict logins to members of this org

# --- Google (also allows http://localhost) -----------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_DOMAIN=tigera.io   # optional: restrict to this Workspace domain

# --- Slack (requires an HTTPS redirect - use an https tunnel, e.g. ngrok, and
#     set AUTH_BASE_URL to that https origin instead of localhost) -------------
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_TEAM=T0123456789    # optional: restrict to this Slack team id/domain
# Since slack doesn't offer a Login, use an inviter here so users can signup for your slack.
# SLACK_WORKSPACE_URL=https://calicousers.slack.com